# Meta Model API ($150 aktif)
MODEL_API_KEY=your_meta_api_key_here
# JANGAN pernah tulis key literal di perintah/prompt. Ambil via file .env (gitignored).
META_API_BASE_URL=https://api.meta.ai/v1
# Standard mode: isi prompt TIDAK dipakai untuk training Meta (penting untuk data pembayaran)
DEFAULT_MODEL=muse-spark-1.3
EXECUTIVE_MODEL=muse-wonder-1.0
IMAGE_MODEL=muse-image-1.0

# Modal GPU T4 ($100 aktif, workspace baiwormyid)
MODAL_WORKSPACE=baiwormyid
# GPU SAM 2.1 jalan INTERNAL di app yang sama -> TIDAK ada endpoint publik.

# Toko
STORE_NAME=Bakpao.my.id
STORE_BASE_URL=http://localhost:8000
# Aset QRIS statis (sudah ada di repo):
#   src/static/assets/merchant-qris.png  (fallback tampilan)
MERCHANT_QRIS_IMAGE=static/assets/merchant-qris.png
# Payload QRIS statis (sumber kebenaran)
MERCHANT_QRIS_PAYLOAD_FILE=src/data/merchant_qris.txt
# dynamic | static | url   (default static; ubah ke dynamic setelah uji HP selesai)
QR_MODE=static
PORT=8000
DEBUG=true
# Direktori data order (di Modal: /data via volume)
DATA_DIR=data
